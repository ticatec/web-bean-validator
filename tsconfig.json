{
	"compilerOptions": {
		"esModuleInterop": true,
		"target": "es2017",
		"resolveJsonModule": true,
		"moduleResolution": "node",
		"declaration": true,
		"sourceMap": false,
		"rootDir": "src",
		"outDir": "dist"
	},
	"lib": ["es2017"],
	"exclude": [
		"dist",
		"node_modules",
		"src/__tests__"
	]
}
